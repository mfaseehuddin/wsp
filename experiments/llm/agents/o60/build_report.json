{
 "groups": [
  {
   "name": "normaliser C",
   "tensors": [
    "model.layers.0.self_attn.v_proj.bias[0]",
    "model.layers.0.self_attn.o_proj.weight[:, 0]",
    "model.layers.9.self_attn.v_proj.bias[0]",
    "model.layers.9.self_attn.o_proj.weight[:, 0]"
   ],
   "mechanism": "bias-only head adds exactly C*u0 at every position (layer 0) and removes it (layer 8)",
   "why": "makes every RMSNorm in the inserted layers divide by ~C/sqrt(896), so reads are linear; u0 is orthogonal to the digit/+/= embeddings so the constant channel is exact there"
  },
  {
   "name": "token flags",
   "tensors": [
    "model.layers.0.mlp.gate_proj.weight[0:24]",
    "model.layers.0.mlp.up_proj.weight[0:24]",
    "model.layers.0.mlp.down_proj.weight[:, 0:24]"
   ],
   "mechanism": "step detectors for 0-9,'+','=' -> DIG, VAL, P, E flags",
   "why": "dot with the token's own embedding; threshold between self-similarity and the best other vocab token"
  },
  {
   "name": "offset fetch",
   "tensors": [
    "model.layers.1.self_attn.q_proj.bias",
    "model.layers.1.self_attn.k_proj",
    "model.layers.1.self_attn.v_proj.weight[0:4]",
    "model.layers.1.self_attn.v_proj.weight[64:68]",
    "model.layers.1.self_attn.o_proj.weight[:, 0:896]"
   ],
   "mechanism": "head d (0..12) attends exactly to offset d+1 and copies its flags; head 13 measures 1/(la+1) for zero-shot",
   "why": "constant q/k biases: score = 40*sum_{i<6} cos(w_i(D-d)) + 480 cos(w_15 D); margin >= 32 for D<=4000"
  },
  {
   "name": "anchor logic",
   "tensors": [
    "model.layers.1.mlp.gate_proj.weight[0:72]",
    "model.layers.1.mlp.up_proj.weight[0:72]",
    "model.layers.1.mlp.down_proj.weight[:, 0:72]"
   ],
   "mechanism": "digit-run validity, masked digits per place, '+' before B, zero-shot masks",
   "why": "integer thresholds"
  },
  {
   "name": "answer position",
   "tensors": [
    "model.layers.1.mlp.gate_proj.weight[72:98]",
    "model.layers.1.mlp.up_proj.weight[72:98]",
    "model.layers.1.mlp.down_proj.weight[:, 72:98]"
   ],
   "mechanism": "k = distance to nearest '=' through digits",
   "why": "integer thresholds"
  },
  {
   "name": "zero-shot mask",
   "tensors": [
    "model.layers.2.mlp.gate_proj.weight[0:36]",
    "model.layers.2.mlp.up_proj.weight[0:36]",
    "model.layers.2.mlp.down_proj.weight[:, 0:36]"
   ],
   "mechanism": "mask A places beyond the true length at text start",
   "why": "integer thresholds"
  },
  {
   "name": "copy A",
   "tensors": [
    "model.layers.3.self_attn"
   ],
   "mechanism": "'=' copies A's digits from the most recent '+'",
   "why": "content key 5000*P + recency -3250 sin(w15 D)"
  },
  {
   "name": "generate/kill",
   "tensors": [
    "model.layers.3.mlp.gate_proj.weight[0:74]",
    "model.layers.3.mlp.up_proj.weight[0:74]",
    "model.layers.3.mlp.down_proj.weight[:, 0:74]"
   ],
   "mechanism": "g_j=[a_j+b_j>=10], k_j=[a_j+b_j<=8] summed into C_p=sum_{j<p}(g_j-k_j)2^j; V, [L>=p]",
   "why": "sign of C_p = carry lookahead (highest non-9 place decides)"
  },
  {
   "name": "carries",
   "tensors": [
    "model.layers.4.mlp.gate_proj.weight[0:24]",
