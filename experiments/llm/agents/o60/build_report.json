    "model.layers.4.mlp.down_proj.weight[:, 0:24]"
   ],
   "mechanism": "c_p=[C_p>=1], top carry -> sum digits s_p and answer length n",
   "why": "s_p=a_p+b_p+c_p-10c_{p+1}"
  },
  {
   "name": "export sums",
   "tensors": [
    "model.layers.5.mlp.gate_proj.weight[0:40]",
    "model.layers.5.mlp.up_proj.weight[0:40]",
    "model.layers.5.mlp.down_proj.weight[:, 0:40]"
   ],
   "mechanism": "s_p, n, V re-written at 0.1 scale at valid '=' only",
