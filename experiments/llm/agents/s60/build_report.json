{
 "groups": [
  {
   "name": "L0 constant+classifier",
   "tensors": [
    "model.layers.0-11 (see EXPLANATION.md)"
   ],
   "mechanism": "adds C=4096 on dim c0 (fixes RMSNorm scale); neurons detect digit/+/= tokens",
   "why": "closed-form ridge LDA directions u_c with u_c.e_c=1 and 0 on the other 12 relevant tokens"
  },
  {
   "name": "L1 banks",
   "tensors": [
    "model.layers.1"
   ],
   "mechanism": "14 heads at fixed offsets d test isPlus / nondigit / isEq; MLP picks first hit (lb, la, nearest '=')",
   "why": "RoPE phase query peaks exactly at offset d"
  },
  {
   "name": "L2-L3 gathers+cleanup",
   "tensors": [
    "model.layers.2-3"
   ],
   "mechanism": "24 heads gather b_k (offset k+1) and a_k (offset lb+2+k); la transferred from '+'; saturating cleanup; gated effective digits",
   "why": "query = sum_d lbo_d * phase(d+1+k) is linear in the one-hot"
  },
  {
   "name": "L4-L6 carry/sum/length",
   "tensors": [
    "model.layers.4-6"
   ],
   "mechanism": "G/P indicators, carry c_k=OR_j G_j AND P_(j+1..k-1), sum digit one-hot (g+c) mod 10, answer length n=M+c_M",
   "why": "threshold neurons relu(sum-(m-1)) implement AND; triangle neurons implement integer indicators"
  },
  {
   "name": "L7 answer layout",
   "tensors": [
    "model.layers.7"
   ],
   "mechanism": "A_{i,x}= s_{n-1-i,x} AND n (MSB-first), EOS marker at i=n",
   "why": "AND neurons"
  },
  {
   "name": "L8 answer read",
   "tensors": [
    "model.layers.8"
   ],
   "mechanism": "head i attends offset i to the nearest '=' (first-hit one-hot) and reads block A_i into ANS",
   "why": "answer position p_eq+i is exactly offset i from '='"
  },
  {
   "name": "R1-R4 mirrors",
   "tensors": [
    "model.layers.9-12"
   ],
   "mechanism": "same neurons/heads with negated writes, erase all scratch and the constant",
   "why": "exact uncomputation keeps every non-addition token unchanged"
  },
  {
   "name": "conversion",
   "tensors": [
    "model.layers.11 (last 11 neurons)"
   ],
   "mechanism": "ANS_x -> boost vector U_x on the unembedding rows of digit x / newline, erases ANS",
   "why": "U_x = pinv of final-norm-weighted embeddings of the 11 target tokens, scaled GBOOST*RMSF"
  }
 ],
